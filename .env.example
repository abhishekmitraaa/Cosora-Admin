# Same Supabase project as textile-spark-net (same DB, same RLS).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# ── Optional, added by the Phase-4 UI pass ────────────────────────────────
# Neither is a secret and neither is required to run the panel.

# Microsoft Clarity project id, for the Live Activity page. Not a secret: it
# ships in the buyer site's own tracking snippet. Without it that page still
# renders and says it is unconfigured, with links to the Clarity project list.
VITE_CLARITY_PROJECT_ID=

# Optional MapLibre style URL for the Geography heat map. Leave blank to use
# OpenStreetMap raster tiles, which need no key. Set it to a MapTiler / Stadia /
# Protomaps style (with their key in the URL) for a vector basemap and a proper
# dark style; nothing else in the page changes.
VITE_MAP_STYLE_URL=

# ── Test credentials (Master Prompt 8, Phase 1) ─────────────────────────────
# Scripts read these through scripts/lib/test-credentials.mjs. Not VITE_-prefixed,
# so never bundled. Values: ask the project owner. Never commit a value.
# demo-buyer / demo-vendor / demo-admin (super_admin) @cosora.dev
DEMO_BUYER_PASSWORD=
DEMO_VENDOR_PASSWORD=
DEMO_ADMIN_PASSWORD=
# rlstest-* / chatfx-* fixtures (seeded per run, then dropped - see README)
FIXTURE_PASSWORD=
